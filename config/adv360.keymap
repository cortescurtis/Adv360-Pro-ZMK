#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        bt_hold: bt_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "BT_HOLD";
            bindings = <&bt>, <&none>;

            #binding-cells = <2>;
            tapping-term-ms = <100>;
            flavor = "balanced";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL   &kp N7           &kp N5                &kp N3            &kp N1          &kp N9     &mo 1                                                               &mo 3      &kp N0    &kp N2           &kp N4             &kp N6                 &kp N8            &kp MINUS
&kp BSLH    &kp B            &kp Y                 &kp O             &kp U           &kp SQT    &kp HOME                                                            &kp PG_UP  &kp SEMI  &kp L            &kp D              &kp W                  &kp V             &kp FSLH
&kp ESCAPE  &hm LEFT_ALT C   &hm LCTRL I           &hm LEFT_SHIFT E  &hm LEFT_GUI A  &kp Z      &kp END   &kp GRAVE  &kp LC(C)          &kp LC(V)        &sk TILDE  &kp PG_DN  &kp Q     &hm RIGHT_GUI H  &hm RIGHT_SHIFT T  &hm LCTRL S            &hm LEFT_ALT N    &kp TAB
&kp LBKT    &hm RIGHT_ALT G  &kp X                 &kp J             &kp K           &kp COMMA                       &kp LC(LS(C))      &kp LG(V)                              &kp DOT   &kp R            &kp M              &kp F                  &hm RIGHT_ALT P   &kp RBKT
&mo 2       &kp LESS_THAN    &kp LEFT_PARENTHESIS  &kp LEFT          &kp RIGHT                  &kp BSPC  &kp DEL    &kp INS            &kp PRINTSCREEN  &kp ENTER  &kp SPACE            &kp DOWN         &kp UP_ARROW       &kp RIGHT_PARENTHESIS  &kp GREATER_THAN  &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&none  &none         &none      &none      &none         &none  &trans                                    &tog 1  &kp DLLR  &kp KP_NUM  &kp KP_EQUAL     &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp PRCNT
&none  &none         &none      &none      &none         &none  &trans                                    &trans  &kp LBKT  &kp KP_N7   &kp KP_N8        &kp KP_N9      &kp KP_MINUS     &kp RBKT
&none  &kp LEFT_ALT  &kp LCTRL  &kp LSHFT  &kp LEFT_GUI  &none  &trans  &none   &none      &none  &none   &trans  &kp LPAR  &kp KP_N4   &kp KP_N5        &kp KP_N6      &kp KP_PLUS      &kp RPAR
&none  &kp RALT      &none      &none      &none         &none                  &none      &none                  &kp LT    &kp KP_N1   &kp KP_N2        &kp KP_N3      &kp KP_ENTER     &kp GT
&none  &none         &none      &none      &none                &trans  &trans  &none      &none  &trans  &trans            &kp HASH    &kp KP_NUMBER_0  &kp KP_DOT     &kp LEFT_BRACE   &kp RBRC
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2    &kp F3     &kp F4          &kp F5        &kp F6  &tog 2                                  &tog 2  &kp F7  &kp F8         &kp F9           &kp F10    &kp F11   &kp F12
&none   &none     &none      &none           &none         &none   &none                                   &none   &none   &none          &none            &none      &none     &none
&none   &kp LALT  &kp LCTRL  &kp LEFT_SHIFT  &kp LEFT_GUI  &none   &none   &none  &none      &none  &none  &none   &none   &kp RIGHT_GUI  &kp RIGHT_SHIFT  &kp RCTRL  &kp LALT  &none
&none   &kp RALT  &none      &none           &none         &none                  &none      &none                 &none   &none          &none            &none      &kp RALT  &none
&trans  &none     &none      &none           &none                 &none   &none  &none      &none  &none  &none           &none          &none            &none      &none     &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&bootloader  &none       &none            &none  &none  &none  &tog 3                                                                        &trans        &none         &none                 &none       &none                 &none               &bootloader
&none        &none       &none            &none  &none  &none  &none                                                                         &none         &none         &kp C_BRIGHTNESS_DEC  &none       &kp C_BRIGHTNESS_INC  &none               &none
&none        &bl BL_TOG  &none            &none  &none  &none  &studio_unlock  &bt BT_SEL 0  &bt BT_SEL 1      &bt BT_CLR_ALL  &bt BT_CLR    &none         &kp C_REWIND  &kp C_PREVIOUS        &kp C_PLAY  &kp C_NEXT            &kp C_FAST_FORWARD  &none
&none        &none       &rgb_ug RGB_TOG  &none  &none  &none                                &bt BT_SEL 2      &none                                       &none         &kp C_VOL_DN          &kp K_MUTE  &kp C_VOLUME_UP       &none               &none
&none        &none       &none            &none  &none         &bt BT_PRV      &bt BT_NXT    &bt BT_SEL 3      &bt BT_SEL 4    &out OUT_USB  &out OUT_BLE                &none                 &none       &none                 &none               &none
            >;
        };
    };
};
