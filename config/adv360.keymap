#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        bt_hold: bt_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "BT_HOLD";
            bindings = <&bt>, <&none>;

            #binding-cells = <2>;
            tapping-term-ms = <100>;
            flavor = "balanced";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1     &kp N2      &kp N3    &kp N4     &kp N5  &tog 1                                                                                    &mo 3                       &kp N6  &kp N7    &kp N8        &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp SQT    &kp COMMA   &kp DOT   &kp P      &kp Y   &sk LA(LC(LEFT_SHIFT))                                                                    &sk LA(LC(LG(LEFT_SHIFT)))  &kp F   &kp G     &kp C         &kp R     &kp L     &kp SLASH
&kp ESC    &kp A      &kp O       &kp E     &kp U      &kp I   &bt_hold BT_SEL 0 1     &kp LCTRL  &kp LGUI               &sk RIGHT_GUI        &sk RCTRL  &bt_hold BT_SEL 0 3         &kp D   &kp H     &kp T         &kp N     &kp S     &kp BACKSLASH
&sk LSHFT  &kp SEMI   &kp Q       &kp J     &kp K      &kp X                                      &mt LEFT_ALT HOME      &mt LEFT_ALT PG_UP                                          &kp B   &kp M     &kp W         &kp V     &kp Z     &sk RSHFT
&mo 2      &kp GRAVE  &caps_word  &kp LEFT  &kp RIGHT          &kp BSPC                &kp DEL    &mt RIGHT_ALT END      &mt RIGHT_ALT PG_DN  &kp ENTER  &kp SPACE                           &kp DOWN  &kp UP_ARROW  &kp LBKT  &kp RBKT  &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&trans  &none   &none  &none   &none   &none  &trans                                        &trans     &kp DLLR  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp PRCNT
&trans  &none   &none  &none   &none   &none  &trans                                        &trans     &kp LBKT  &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp RBKT
&trans  &none   &none  &none   &none   &none  &trans  &trans  &trans      &trans  &kp HASH  &trans     &kp LPAR  &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp RPAR
&trans  &none   &none  &none   &none   &none                  &trans      &trans                       &kp LT    &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp GT
&trans  &trans  &none  &trans  &trans         &trans  &trans  &trans      &trans  &trans    &kp KP_N0            &trans      &trans        &kp KP_DOT     &kp LEFT_BRACE   &kp RBRC
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &none            &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};
